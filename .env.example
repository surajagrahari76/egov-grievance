# Application Environment (dev | staging | prod)
APP_ENV=dev
APP_NAME=JanSamadhan AI - E-Governance Grievance Redressal
SECRET_KEY=dev-super-secret-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for local dev; Postgres URL for Docker/prod)
DATABASE_URL=sqlite:///./grievance_dev.db

# Background Jobs (apscheduler for local dev; celery for Docker/prod)
JOB_RUNNER=apscheduler
REDIS_URL=redis://localhost:6379/0

# AI Configuration (leave blank to use deterministic rule/TF-IDF fallback)
AI_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo Mode
DEMO_MODE=true
